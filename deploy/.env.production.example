COMPOSE_PROJECT_NAME=company-dsh-production
POSTGRES_PASSWORD=replace-with-production-database-password
DATABASE_URL=postgresql://company_dsh:replace-with-production-database-password@postgres:5432/company_dsh
INTERNAL_SERVICE_TOKEN=replace-with-independent-random-service-token
ACTOR_TOKEN_SECRET=replace-with-independent-random-actor-token-secret-at-least-32-characters
ACTOR_TOKEN_ISSUER=company-control-plane
MODEL_SECRET_KEY_BASE64=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
RUNNER_IDENTITY_SECRET_BASE64=BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB=
RUNNER_DATA_ROOT=/srv/company-dsh/users
DOCKER_GID=999
RUNNER_IMAGE=company-dsh-runner:99f6f02f
RUNNER_IMAGE_VERSION=99f6f02fecdb7dff40c3fbc9470f5907c29f74ca
RUNNER_INGRESS_NETWORK=company-runner-production
RUNNER_EGRESS_NETWORK=company-runner-egress-production
COMPANY_AGENT_TOOL_GATEWAY_URL=http://control-plane:8080/internal/v1/agent-tools/query-company-system
GATEWAY_PORT=8080
WORKBENCH_ENTRY_URL=/workbench
MODEL_BASE_URL_ALLOWLIST=
KNOWLEDGE_PROVIDER=disabled
AUTOMATION_PROVIDER=internal
AUTOMATION_EXECUTOR=model
BOOTSTRAP_TENANT_NAME=Company
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_DISPLAY_NAME=Administrator
BOOTSTRAP_ADMIN_PASSWORD=replace-with-one-time-bootstrap-password
