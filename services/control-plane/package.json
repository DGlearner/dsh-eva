{
  "name": "@company/control-plane",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "pnpm run build && node --watch dist/main.js",
    "start": "node dist/main.js",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@company/contracts": "workspace:*",
    "@company/db": "workspace:*",
    "@company/observability": "workspace:*",
    "@company/dsh-runner": "workspace:*",
    "argon2": "^0.44.0",
    "drizzle-orm": "^0.44.0",
    "fastify": "^5.0.0",
    "ioredis": "^5.0.0",
    "jose": "^6.0.0",
    "pg": "^8.0.0",
    "ws": "^8.0.0"
  },
  "devDependencies": {
    "@types/pg": "^8.15.0",
    "@types/ws": "^8.5.0"
  }
}
