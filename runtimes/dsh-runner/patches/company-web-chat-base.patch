diff --git a/packages/client/connection/src/runner-identity.ts b/packages/client/connection/src/runner-identity.ts
new file mode 100644
index 0000000..adc6b86
--- /dev/null
+++ b/packages/client/connection/src/runner-identity.ts
@@ -0,0 +1,90 @@
+import { createHmac, timingSafeEqual } from 'node:crypto'
+import type { IncomingHttpHeaders } from 'node:http'
+
+interface RunnerIdentityRequest {
+  headers: IncomingHttpHeaders | Headers
+}
+
+interface RunnerIdentityClaims {
+  iss?: unknown
+  aud?: unknown
+  iat?: unknown
+  exp?: unknown
+  tenant_id?: unknown
+  user_id?: unknown
+  runner_id?: unknown
+  request_id?: unknown
+}
+
+function required(env: NodeJS.ProcessEnv, name: string): string {
+  const value = env[name]
+  if (!value) throw new Error(`client-connection: ${name} is required`)
+  return value
+}
+
+function header(headers: IncomingHttpHeaders | Headers, name: string): string | undefined {
+  if (headers instanceof Headers) return headers.get(name) ?? undefined
+  const value = headers[name]
+  return typeof value === 'string' ? value : undefined
+}
+
+function jsonSegment(value: string): Record<string, unknown> | undefined {
+  if (!/^[A-Za-z0-9_-]+$/u.test(value)) return undefined
+  try {
+    const parsed = JSON.parse(Buffer.from(value, 'base64url').toString('utf8')) as unknown
+    return parsed && typeof parsed === 'object' && !Array.isArray(parsed)
+      ? parsed as Record<string, unknown>
+      : undefined
+  } catch {
+    return undefined
+  }
+}
+
+export function createRunnerIdentityVerifier(
+  env: NodeJS.ProcessEnv = process.env,
+): (request: RunnerIdentityRequest) => boolean {
+  const secret = Buffer.from(required(env, 'COMPANY_RUNNER_IDENTITY_SECRET_BASE64'), 'base64')
+  if (secret.byteLength < 32) {
+    throw new Error('client-connection: Runner identity secret must contain at least 32 bytes')
+  }
+  const tenantId = required(env, 'COMPANY_TENANT_ID')
+  const userId = required(env, 'COMPANY_USER_ID')
+  const runnerId = required(env, 'COMPANY_RUNNER_ID')
+
+  return (request): boolean => {
+    const authorization = header(request.headers, 'authorization')
+    if (!authorization?.startsWith('Bearer ')) return false
+    const token = authorization.slice('Bearer '.length)
+    const segments = token.split('.')
+    if (segments.length !== 3) return false
+    const [protectedSegment, claimsSegment, signatureSegment] = segments as [string, string, string]
+    const protectedHeader = jsonSegment(protectedSegment)
+    const claims = jsonSegment(claimsSegment) as RunnerIdentityClaims | undefined
+    if (protectedHeader?.alg !== 'HS256' || protectedHeader.typ !== 'JWT' || !claims) return false
+    if (!/^[A-Za-z0-9_-]+$/u.test(signatureSegment)) return false
+    const actualSignature = Buffer.from(signatureSegment, 'base64url')
+    const expectedSignature = createHmac('sha256', secret)
+      .update(`${protectedSegment}.${claimsSegment}`, 'ascii')
+      .digest()
+    if (
+      actualSignature.byteLength !== expectedSignature.byteLength
+      || !timingSafeEqual(actualSignature, expectedSignature)
+    ) return false
+
+    const now = Math.floor(Date.now() / 1000)
+    return claims.iss === 'company-control-plane'
+      && claims.aud === 'company-dsh-runner'
+      && claims.tenant_id === tenantId
+      && claims.user_id === userId
+      && claims.runner_id === runnerId
+      && typeof claims.request_id === 'string'
+      && claims.request_id.length >= 8
+      && claims.request_id.length <= 128
+      && typeof claims.iat === 'number'
+      && claims.iat <= now + 30
+      && claims.iat >= now - 120
+      && typeof claims.exp === 'number'
+      && claims.exp > now
+      && claims.exp <= claims.iat + 120
+  }
+}
